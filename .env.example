# Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (SQLite default for portability and zero configuration)
DATABASE_URL="file:./dev.db"

# JWT Secrets (Generate secure random 64-character strings for production)
JWT_ACCESS_SECRET="codeprep-dev-access-secret-replace-in-production-min-32-chars"
JWT_REFRESH_SECRET="codeprep-dev-refresh-secret-replace-in-production-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Cookie Security
COOKIE_SECRET="codeprep-cookie-signing-secret-replace-in-production"
SECURE_COOKIES=false # Set to true when serving over HTTPS

# Time Zone Configuration
DEFAULT_TIMEZONE="Asia/Kolkata"

# AI Provider Configuration (Swappable behind one interface)
# Supported: gemini, claude, mock (for local offline testing)
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Sandbox Runner Configuration
SANDBOX_TYPE="docker" # docker | local-process
SANDBOX_TIMEOUT_MS=2000
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_QUOTA=1.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_MAX_SUBMISSIONS=60

