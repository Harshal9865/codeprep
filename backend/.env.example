# Server & App URLs
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# SQLite Persistence (In production container/VPS, point to persistent volume path e.g. file:/data/codeprep.db)
DATABASE_URL="file:./dev.db"

# Auth Secrets (Generate unique 32+ char strings in production)
JWT_ACCESS_SECRET=replace-with-32-char-random-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-random-refresh-secret
COOKIE_SECRET=replace-with-random-cookie-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Set SECURE_COOKIES=true when served over HTTPS
SECURE_COOKIES=false
DEFAULT_TIMEZONE=Asia/Kolkata

# Execution Sandbox (g++ binary path optional override on Windows)
SANDBOX_TYPE=local-process
SANDBOX_TIMEOUT_MS=2000
# CPP_COMPILER=C:\msys64\ucrt64\bin\g++.exe

